{
  "expo": {
    "name": "Inhabitants",
    "slug": "SkateSpotApp",
    "version": "1.17.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inhabitants",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:inhabitants.chottu.link"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to center the map near you.",
        "NSUserNotificationsUsageDescription": "We'll notify you when someone interacts with your spots.",
        "NSContactsUsageDescription": "Inhabitants uses your contacts to let you invite friends to the app.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.aaronbush.inhabitants",
      "config": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.aaronbush.inhabitants",
      "config": {
        "googleMaps": {}
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-contacts",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a1a",
          "dark": {
            "backgroundColor": "#1a1a1a"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-status-bar",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "${GOOGLE_MAPS_API_KEY}",
          "androidGoogleMapsApiKey": "${GOOGLE_MAPS_API_KEY}"
        }
      ],
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3766e044-8061-46dc-bf9e-ca194b4eb0b4"
      }
    },
    "owner": "ambush3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3766e044-8061-46dc-bf9e-ca194b4eb0b4"
    }
  }
}
